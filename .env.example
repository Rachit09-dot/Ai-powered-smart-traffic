# AI Smart Traffic & Accident Detection System — Environment Variables
# Copy this file to .env and set values for your environment.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME="AI Smart Traffic & Accident Detection System"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# ─── YOLO / Computer Vision ───────────────────────────────────────────────────
YOLO_MODEL_NAME="yolov8n.pt"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
PROCESSING_TARGET_FPS=15
MAX_PROCESSING_FRAME_WIDTH=960

# ─── Traffic Congestion Thresholds ────────────────────────────────────────────
CONGESTION_LOW_MAX=5
CONGESTION_MEDIUM_MAX=12

# ─── Anomaly / Accident Heuristics ────────────────────────────────────────────
STOPPED_VEHICLE_TIME_THRESHOLD_SEC=4.0
COLLISION_IOU_THRESHOLD=0.15
ALERT_COOLDOWN_SECONDS=30

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=250

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Production: specify allowed origins explicitly
# CORS_ORIGINS=["http://localhost:5173","https://yourdomain.com"]
# Development: set to True to allow all origins (NOT for production)
CORS_ALLOW_ALL=False

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: sqlite+aiosqlite:///backend/data/traffic_system.db
# Override only if you need a custom path:
# DATABASE_URL=sqlite+aiosqlite:///path/to/custom.db
